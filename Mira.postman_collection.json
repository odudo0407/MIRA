  "item": [
    {
      "name": "TC-01",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"TC-01 返回 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"TC-01 token 存在\", () => {\r",
              "    pm.expect(pm.response.json().token).to.exist;\r",
              "});\r",
              "pm.test(\"TC-01 user.email 匹配\", () => {\r",
              "    const body = JSON.parse(pm.request.body.raw);\r",
              "    pm.expect(pm.response.json().user.email).to.eql(body.email);\r",
              "});\r",
              "pm.test(\"TC-01 user.name 匹配\", () => {\r",
              "    const body = JSON.parse(pm.request.body.raw);\r",
              "    pm.expect(pm.response.json().user.name).to.eql(body.nickname);\r",
              "});\r",
              "pm.test(\"TC-01 is_admin=false\", () => {\r",
              "    pm.expect(pm.response.json().user.is_admin).to.be.false;\r",
              "});\r",
              "// 自动保存 token\r",
              "pm.environment.set(\"token\", pm.response.json().token);\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"test_001@mira.local\",\r\n  \"password\": \"Test123456\",\r\n  \"nickname\": \"测试用户\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
